# csp-catalog-portal environment variables
# Copy to .env and fill in values. NEVER commit .env

# The shell owns the gateway URL, authentication, and HTTP client configuration.
# This portal must not define or consume GATEWAY_URL directly.

# The local development server port is configured in angular.json (4203), and the container
# publishes the same port as 4203:80, so this portal reads no PORT variable.

# Origins allowed to load remoteEntry.json and the modules from another origin (ADR-026).
# The container refuses to start without it; deploy/compose.yml sets the development value.
# CORS_ALLOWED_ORIGIN_REGEX=^http://localhost:420[0-5]$